# ─────────────────────────────────────────────────────────────
# 이 파일을 .env 로 복사한 뒤 각 값을 채워서 사용하세요.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있으므로 커밋되지 않습니다.
# 값은 Google Sheets "웹에 게시 → CSV" 링크를 사용합니다.
# 로딩 위치: app/__init__.py (load_dotenv)
# ─────────────────────────────────────────────────────────────

# 현재 시즌(Live) 데이터 URL — 폴백용
# app/routes/pythag.py: preset=live 일 때 PYTHAG_CSV_URL_2026 이 없으면 이 값을 사용
PYTHAG_CSV_URL=

# --- 시즌별 프리셋 URL ---
# 2026 시즌 (현재 Live 시즌으로 사용 중)
PYTHAG_CSV_URL_2026=

# 2025 시즌 프리셋용 데이터 URL
PYTHAG_CSV_URL_2025=

# 2024 시즌 프리셋용 데이터 URL
PYTHAG_CSV_URL_2024=

# (선택) 로컬 엑셀 파일 경로 — 미설정 시 위 CSV URL 사용
# app/routes/pythag.py: DATA_XLSX
PYTHAG_XLSX=
